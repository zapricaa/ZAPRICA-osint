# ZAPRICA Backend Configuration
# Copy this file to .env and fill in actual values

# Database
DATABASE_URL=postgresql+asyncpg://zaprica:zaprica_dev@localhost:5432/zaprica
DATABASE_URL_SYNC=postgresql://zaprica:zaprica_dev@localhost:5432/zaprica

# Application
APP_NAME=ZAPRICA
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Authentication
JWT_SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-SECRET-KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Configuration (optional - features degrade gracefully without these)
PLANNER_LLM_PROVIDER=openai
PLANNER_LLM_API_KEY=
PLANNER_LLM_MODEL=gpt-4o
EXTRACTOR_LLM_PROVIDER=openai
EXTRACTOR_LLM_API_KEY=
EXTRACTOR_LLM_MODEL=gpt-4o-mini

# Evidence Storage (optional - falls back to local filesystem)
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_STORAGE_PATH=./evidence_store
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Shell Worker (requires Docker - disabled if unavailable)
SHELL_WORKER_ENABLED=false
SHELL_WORKER_TIMEOUT_SECONDS=30
SHELL_WORKER_MEMORY_LIMIT=256m

# Browser Worker
BROWSER_WORKER_ENABLED=false
BROWSER_WORKER_TIMEOUT_SECONDS=60
