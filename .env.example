# ZAPRICA Environment Configuration
# Copy to .env for local development. Never commit .env with secrets.

APP_ENV=development
API_BASE_URL=http://localhost:8000
SECRET_KEY=dev-secret-key-change-in-production-must-be-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# In local development, SQLite (sqlite+aiosqlite:///./zaprica.db) or PostgreSQL can be used.
DATABASE_URL=sqlite+aiosqlite:///./zaprica.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://zaprica:zaprica_password@localhost:5432/zaprica

# Evidence Storage Configuration
# local or s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/evidence
# For S3:
# STORAGE_BACKEND=s3
# OBJECT_STORE_ENDPOINT=http://localhost:9000
# OBJECT_STORE_BUCKET=zaprica-evidence
# OBJECT_STORE_ACCESS_KEY=minioadmin
# OBJECT_STORE_SECRET_KEY=minioadmin
# OBJECT_STORE_REGION=us-east-1

# LLM Configuration
# Options: mock, gemini, openai
LLM_PROVIDER=mock
# LLM_API_KEY=your-api-key-here
# LLM_MODEL_NAME=gemini-2.5-flash

# Logging
LOG_LEVEL=INFO
