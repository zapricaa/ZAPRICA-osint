# ==============================================================================
# ZAPRICA — Environment Configuration Template
# Copy this file to '.env' and adjust parameters for your environment.
# DO NOT commit real API keys, passwords, or production secrets to version control.
# ==============================================================================

APP_ENV=development
PROJECT_NAME="ZAPRICA OSINT"
API_BASE_URL=http://localhost:8000

# Authentication & Cryptographic Keys
# Generate via: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
# Generate via: openssl rand -hex 16 (Used only once to bootstrap the initial SUPER_ADMIN)
BOOTSTRAP_SECRET=change-this-to-a-secure-bootstrap-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# SQLite (default development): sqlite+aiosqlite:///./zaprica.db
# PostgreSQL (production): postgresql+asyncpg://zaprica_user:password@localhost:5432/zaprica_db
DATABASE_URL=sqlite+aiosqlite:///./zaprica.db

# Evidence Storage Backend
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/evidence

# Optional S3 / MinIO Object Storage
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=zaprica-evidence
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_REGION=us-east-1

# Google Gemini AI Brain
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAIN_HEAD_MODEL=gemini-2.0-flash
GEMINI_BROWSER_HEAD_MODEL=gemini-2.0-flash-lite
GEMINI_TERMINAL_HEAD_MODEL=gemini-2.0-flash-lite

# Dedicated Sandboxes & Isolation Backends
DOCKER_SANDBOX_IMAGE=zaprica-sandbox:latest
BROWSER_PROFILES_DIR=./data/browser_profiles
BROWSER_HEADLESS=true

# Safe Application Startup Invariants
# ZAPRICA_SAFE_MODE=true starts all worker agents in IDLE and terminal in fail-closed state
ZAPRICA_SAFE_MODE=true
TERMINAL_EXECUTION_ENABLED=false
TERMINAL_SANDBOX_REQUIRED=true
BROWSER_AUTOMATION_ENABLED=false
BROWSER_SESSION_AUTOSTART=false
AUTO_INVESTIGATION_ENABLED=false
AUTO_TOOL_INSTALLATION=false

# OSINT Collectors (Data Collection Engine)
HIBP_API_KEY=
HOLEHE_ENABLED=false
THEHARVESTER_SOURCES=crtsh
DCE_DEMO_MODE=false

# Logging Verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

